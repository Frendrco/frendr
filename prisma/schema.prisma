generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id          String   @id @default(cuid())
  clerkId     String   @unique
  username    String   @unique
  displayName String
  location    String?
  age         Int?
  bio         String?
  website     String?
  role        String?
  pronouns    String?
  creatorType String?
  instagram   String?
  linkedin    String?
  twitter     String?
  patreon     String?
  substack    String?
  playlist    String?
  behance     String?
  other       String?
  isAdmin       Boolean  @default(false)
  openToWork    Boolean  @default(false)
  showAiContent Boolean  @default(true)
  emailNotifyMessages Boolean @default(true)
  emailNotifyComments Boolean @default(true)
  emailNotifyReplies  Boolean @default(true)
  emailNotifyFollows   Boolean @default(true)
  emailNotifyTrending  Boolean @default(true)
  avatarUrl     String?
  coverImageUrl String?
  coverVideoUrl String?
  pinnedVideoId String?
  tags          String[]
  email         String?
  lastActiveAt  DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  videos              Video[]
  videoLikes          VideoLike[]
  threads             Thread[]
  threadVotes         ThreadVote[]
  savedThreads        SavedThread[]
  comments            Comment[]
  commentVotes        CommentVote[]
  jobs                Job[]
  savedJobs           SavedJob[]
  followers           Follow[]        @relation("UserFollowers")
  following           Follow[]        @relation("UserFollowing")
  playlists           Playlist[]
  channels            Channel[]
  channelFollows      ChannelFollow[]
  channelVideosAdded  ChannelVideo[]  @relation("ChannelVideoAddedBy")
  channelAdmins       ChannelAdmin[]
  events              Event[]
  eventRsvps          EventRsvp[]
  savedEvents         SavedEvent[]
  shop                Shop?
  savedShops          SavedShop[]
  conversations       ConversationParticipant[]
  sentMessages        Message[]
  messageReactions    MessageReaction[]
  notifications       Notification[]
  notificationsFrom   Notification[] @relation("NotifFromUser")
  notificationQueue   NotificationQueue[]
  collaborationsOn    VideoCollaborator[]
}

enum VideoType {
  PORTFOLIO
  RECESS
}

model Video {
  id            String         @id @default(cuid())
  title         String
  description   String?
  streamId      String?
  externalUrl   String?
  thumbnailUrl  String?
  tags          String[]
  categories    String[]
  isPublic       Boolean        @default(true)
  embedAutoplay  Boolean        @default(false)
  embedLoop      Boolean        @default(false)
  embedShowControls Boolean     @default(true)
  allowEmbedding Boolean        @default(true)
  allowDownloads Boolean        @default(false)
  featured       Boolean        @default(false)
  isAiGenerated  Boolean        @default(false)
  videoType      VideoType      @default(PORTFOLIO)
  viewCount      Int            @default(0)
  position       Int?
  userId        String
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  playlists      PlaylistVideo[]
  channels       ChannelVideo[]
  likes          VideoLike[]
  comments       Comment[]
  collaborators  VideoCollaborator[]
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([userId])
  @@index([featured])
  @@index([videoType])
  @@index([videoType, isPublic])
}

model VideoCollaborator {
  id      String   @id @default(cuid())
  videoId String
  userId  String
  role    String?
  status  String   @default("PENDING") // "PENDING" | "ACCEPTED" | "DECLINED"
  addedAt DateTime @default(now())
  video   Video    @relation(fields: [videoId], references: [id], onDelete: Cascade)
  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([videoId, userId])
}

model Thread {
  id         String       @id @default(cuid())
  title      String
  body       String
  tags       String[]
  videoUrl   String?
  imageUrls  String[]
  riveUrls   String[]
  source     String       @default("community")
  voteCount  Int          @default(0)
  userId     String
  user       User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  comments   Comment[]
  votes      ThreadVote[]
  saves      SavedThread[]
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  @@index([userId])
}

model ThreadVote {
  id        String  @id @default(cuid())
  value     Int     // 1 = upvote, -1 = downvote
  userId    String
  threadId  String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  thread    Thread  @relation(fields: [threadId], references: [id], onDelete: Cascade)

  @@unique([userId, threadId])
}

model Comment {
  id              String        @id @default(cuid())
  body            String
  voteCount       Int           @default(0)
  userId          String
  threadId        String?
  videoId         String?
  parentCommentId String?
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  thread          Thread?       @relation(fields: [threadId], references: [id], onDelete: Cascade)
  video           Video?        @relation(fields: [videoId], references: [id], onDelete: Cascade)
  parentComment   Comment?      @relation("CommentReplies", fields: [parentCommentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  replies         Comment[]     @relation("CommentReplies")
  votes           CommentVote[]
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([videoId])
  @@index([threadId])
}

model VideoLike {
  id        String   @id @default(cuid())
  videoId   String
  userId    String
  createdAt DateTime @default(now())
  video     Video    @relation(fields: [videoId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([videoId, userId])
}

model CommentVote {
  id        String  @id @default(cuid())
  value     Int     // 1 = upvote, -1 = downvote
  userId    String
  commentId String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  comment   Comment @relation(fields: [commentId], references: [id], onDelete: Cascade)

  @@unique([userId, commentId])
}

model Follow {
  id          String   @id @default(cuid())
  followerId  String
  followingId String
  follower    User     @relation("UserFollowing", fields: [followerId], references: [id], onDelete: Cascade)
  following   User     @relation("UserFollowers", fields: [followingId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())

  @@unique([followerId, followingId])
  @@index([followingId])
}

model Job {
  id          String      @id @default(cuid())
  title       String
  company     String
  location    String?
  type        String      // full-time, part-time, contract, freelance, internship
  description String
  applyEmail  String?
  userId      String
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  saves       SavedJob[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
}

model SavedThread {
  id       String   @id @default(cuid())
  userId   String
  threadId String
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  thread   Thread   @relation(fields: [threadId], references: [id], onDelete: Cascade)
  savedAt  DateTime @default(now())

  @@unique([userId, threadId])
}

model SavedJob {
  id      String   @id @default(cuid())
  userId  String
  jobId   String
  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  job     Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  savedAt DateTime @default(now())

  @@unique([userId, jobId])
}

model Playlist {
  id          String          @id @default(cuid())
  name        String
  description String?
  isPublic    Boolean         @default(true)
  isDefault   Boolean         @default(false)
  userId      String
  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  videos      PlaylistVideo[]
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
}

model PlaylistVideo {
  id         String   @id @default(cuid())
  playlistId String
  videoId    String
  position   Int      @default(0)
  addedAt    DateTime @default(now())
  playlist   Playlist @relation(fields: [playlistId], references: [id], onDelete: Cascade)
  video      Video    @relation(fields: [videoId], references: [id], onDelete: Cascade)

  @@unique([playlistId, videoId])
}

model Channel {
  id          String          @id @default(cuid())
  name        String
  slug        String          @unique
  description String?
  coverUrl    String?
  color       String?
  isPublic    Boolean         @default(true)
  shareToken  String?         @unique
  featured    Boolean         @default(false)
  sortOrder   Int             @default(0)
  type        String          @default("user")
  userId      String?
  user        User?           @relation(fields: [userId], references: [id], onDelete: SetNull)
  videos      ChannelVideo[]
  followers   ChannelFollow[]
  admins      ChannelAdmin[]
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
}

model ChannelVideo {
  id        String   @id @default(cuid())
  channelId String
  videoId   String
  addedBy   String
  addedAt   DateTime @default(now())
  channel   Channel  @relation(fields: [channelId], references: [id], onDelete: Cascade)
  video     Video    @relation(fields: [videoId], references: [id], onDelete: Cascade)
  curator   User     @relation("ChannelVideoAddedBy", fields: [addedBy], references: [id], onDelete: Cascade)

  @@unique([channelId, videoId])
  @@index([videoId])
}

model ChannelFollow {
  id         String   @id @default(cuid())
  channelId  String
  userId     String
  followedAt DateTime @default(now())
  channel    Channel  @relation(fields: [channelId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([channelId, userId])
}

model ChannelAdmin {
  id        String   @id @default(cuid())
  channelId String
  userId    String
  createdAt DateTime @default(now())
  channel   Channel  @relation(fields: [channelId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([channelId, userId])
}

model Event {
  id           String      @id @default(cuid())
  title        String
  description  String
  date         DateTime
  location     String?
  onlineUrl    String?
  maxAttendees  Int?
  lgbtqFriendly Boolean @default(false)
  userId        String
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  user         User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  rsvps        EventRsvp[]
  saves        SavedEvent[]
}

model EventRsvp {
  id        String   @id @default(cuid())
  userId    String
  eventId   String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([userId, eventId])
}

model Shop {
  id          String      @id @default(cuid())
  name        String
  description String?
  shopUrl     String
  category    String?
  userId      String      @unique
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  saves       SavedShop[]
}

model SavedEvent {
  id        String   @id @default(cuid())
  userId    String
  eventId   String
  savedAt   DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([userId, eventId])
}

model SavedShop {
  id        String   @id @default(cuid())
  userId    String
  shopId    String
  savedAt   DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  shop      Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@unique([userId, shopId])
}

model Conversation {
  id           String                   @id @default(cuid())
  createdAt    DateTime                 @default(now())
  updatedAt    DateTime                 @updatedAt
  participants ConversationParticipant[]
  messages     Message[]
}

model ConversationParticipant {
  id             String       @id @default(cuid())
  conversationId String
  userId         String
  lastReadAt     DateTime?
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
}

model Message {
  id             String              @id @default(cuid())
  conversationId String
  senderId       String
  body           String
  createdAt      DateTime            @default(now())
  conversation   Conversation        @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         User                @relation(fields: [senderId], references: [id], onDelete: Cascade)
  reactions      MessageReaction[]

  @@index([conversationId])
}

model MessageReaction {
  id        String   @id @default(cuid())
  messageId String
  userId    String
  emoji     String
  createdAt DateTime @default(now())
  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId, emoji])
  @@index([messageId])
}

model Notification {
  id          String   @id @default(cuid())
  userId      String
  type        String   // "follow" | "comment" | "reply" | "message" | "vote" | "announcement"
  fromUserId  String?
  contentId   String?
  contentType String?
  message     String?
  read        Boolean  @default(false)
  createdAt   DateTime @default(now())

  user     User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  fromUser User? @relation("NotifFromUser", fields: [fromUserId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([userId, read])
}

model NotificationQueue {
  id        String    @id @default(cuid())
  userId    String
  type      String    // "follow" | "comment" | "reply" | "message"
  data      Json      // { actorName, actorUsername, contentId, contentType }
  createdAt DateTime  @default(now())
  sent      Boolean   @default(false)
  sentAt    DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([sent])
  @@index([userId])
}
